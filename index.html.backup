                    </div>                    <div class="rank-row">
                        <span class="rank-label">第3档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '沙特阿拉伯')" data-team='🇸🇦 沙特阿拉伯'>
