<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FIFA 2026 世界杯观赛日程表</title>
    <style>
        * { box-sizing: border-box; }
        :root {
            --black: #1a1a2e;
            --white: #ffffff;
            --gold: #c8a84e;
            --canada-red: #e63946;
            --usa-blue: #1d3557;
            --mexico-green: #2d6a4f;
            --bg: #0f0f1a;
            --card-bg: #1a1a2e;
            --card-border: #2a2a3e;
            --text: #e0e0e0;
            --text-muted: #8888aa;
        }
        body {
            font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            background-image: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 100%);
        }
        .container { max-width: 960px; margin: 0 auto; }
        header { text-align: center; margin-bottom: 24px; }
        h1 { color: var(--white); margin: 10px 0 5px; font-size: 2.2rem; letter-spacing: 2px; }
        h1 small { display: block; font-size: 0.45em; font-weight: 300; color: var(--gold); letter-spacing: 4px; margin-bottom: 8px; }
        .hosts { display: flex; justify-content: center; gap: 16px; margin: 12px 0 0; font-size: 0.9rem; color: var(--text-muted); }
        .hosts span { opacity: 0.6; }
        .summary-banner {
            background: linear-gradient(135deg, var(--black), #16213e);
            border: 1px solid var(--gold);
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 30px;
            box-shadow: 0 0 30px rgba(200,168,78,0.08), inset 0 0 60px rgba(200,168,78,0.03);
            position: relative; overflow: hidden;
        }
        .summary-banner::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--canada-red), var(--usa-blue), var(--mexico-green));
        }
        .summary-banner h2 { margin: 0 0 18px; font-size: 1.3rem; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }
        .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 20px; }
        .summary-item { background: rgba(255,255,255,0.04); border: 1px solid rgba(200,168,78,0.15); border-radius: 12px; padding: 14px 18px; }
        .summary-item .label { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px; letter-spacing: 1px; }
        .summary-item .value { font-size: 1.25rem; font-weight: 700; color: var(--white); }
        .summary-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
        .btn { display: inline-flex; align-items: center; gap: 6px; background: transparent; color: var(--gold); border: 1px solid var(--gold); padding: 10px 24px; border-radius: 25px; cursor: pointer; font-size: 0.95rem; text-decoration: none; font-weight: 600; transition: all 0.2s; }
        .btn:hover { background: var(--gold); color: var(--black); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(200,168,78,0.25); }
        .btn-outline { background: transparent; color: var(--text); border-color: var(--card-border); }
        .btn-outline:hover { background: rgba(255,255,255,0.08); border-color: var(--text-muted); }
        .date-header { background: linear-gradient(90deg, var(--black), #16213e); color: var(--white); padding: 10px 20px; border-radius: 12px; margin: 20px 0 10px; font-size: 1.1rem; font-weight: 700; display: flex; justify-content: space-between; align-items: center; border-left: 4px solid var(--gold); border-bottom: 1px solid var(--card-border); }
        .date-header .day-count { font-size: 0.8rem; color: var(--gold); background: rgba(200,168,78,0.1); padding: 3px 10px; border-radius: 10px; }
        .match-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 16px 20px; margin-bottom: 8px; display: flex; align-items: center; gap: 15px; transition: all 0.2s; cursor: pointer; }
        .match-card:hover { transform: translateY(-2px); border-color: var(--gold); box-shadow: 0 4px 16px rgba(200,168,78,0.1); }
        .match-time { font-size: 1.3rem; font-weight: 700; color: var(--gold); min-width: 75px; text-align: center; white-space: nowrap; font-variant-numeric: tabular-nums; }
        .match-info { flex: 1; }
        .match-name { font-size: 1.15rem; font-weight: 700; margin-bottom: 4px; color: var(--white); }
        .match-meta { font-size: 0.82rem; color: var(--text-muted); }
        .group-badge { background: rgba(200,168,78,0.12); color: var(--gold); border: 1px solid rgba(200,168,78,0.25); padding: 3px 10px; border-radius: 10px; font-size: 0.75rem; white-space: nowrap; font-weight: 600; }
        .team-banner {
            background: linear-gradient(135deg, rgba(200,168,78,0.15), rgba(200,168,78,0.05));
            border: 1px solid rgba(200,168,78,0.3);
            border-radius: 12px;
            padding: 16px 24px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .team-banner-flag { font-size: 2.5rem; }
        .team-banner-name { font-size: 1.2rem; font-weight: 700; color: var(--gold); margin-bottom: 4px; }
        .team-banner-count { font-size: 0.85rem; color: var(--text-muted); }
        .footer { text-align: center; margin-top: 40px; font-size: 0.8rem; color: var(--text-muted); padding: 20px; border-top: 1px solid var(--card-border); }
        .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); font-size: 1.1rem; }
        .team-selector-section { background: linear-gradient(135deg, #16213e, #1a1a2e); border: 1px solid var(--card-border); border-radius: 16px; padding: 24px 28px; margin-bottom: 30px; }
        .team-selector-section h3 { margin: 0 0 12px; color: var(--gold); font-size: 1.1rem; }
        .selector-row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        #team-select { background: rgba(255,255,255,0.06); color: var(--text); border: 1px solid var(--card-border); padding: 10px 16px; border-radius: 10px; font-size: 1rem; min-width: 260px; cursor: pointer; }
        #team-select option { background: #1a1a2e; color: var(--text); }
        @media (max-width: 600px) {
            .match-card { flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px; }
            .match-time { font-size: 1.1rem; min-width: auto; }
            h1 { font-size: 1.5rem; }
            .summary-banner { padding: 20px; }
            .summary-grid { grid-template-columns: 1fr 1fr; }
            .summary-actions { flex-direction: column; }
            .btn { justify-content: center; }
            .selector-row { flex-direction: column; align-items: stretch; }
            #team-select { min-width: auto; }
        }
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1 id="page-title"><small>FIFA WORLD CUP 2026</small>🏆 世界杯观赛日程表</h1>
            <div class="hosts">🇨🇦 加拿大 &nbsp;|&nbsp; 🇺🇸 美国 &nbsp;|&nbsp; 🇲🇽 墨西哥</div>
        </header>

        <div class="summary-banner">
            <h2>📋 赛事概览</h2>
            <div class="summary-grid">
                <div class="summary-item"><div class="label">⏰ 时间范围</div><div class="value">6月12日 - 6月28日</div></div>
                <div class="summary-item"><div class="label">⏱️ 所有时间</div><div class="value">北京时间</div></div>
                <div class="summary-item"><div class="label">🏆 总场次</div><div class="value" id="total-matches">72 场</div></div>
                <div class="summary-item"><div class="label">📅 比赛天数</div><div class="value">17 天</div></div>
            </div>
            <div class="summary-actions">
                <a href="worldcup2026.ics" class="btn" download>📥 下载全部赛程 ICS</a>
                <a href="data/worldcup2026-matches.json" class="btn btn-outline" download>📊 下载 JSON</a>
                <button class="btn btn-outline" onclick="copyAllSubscribeLink()">🔗 复制全部赛程订阅链接</button>
            </div>
        </div>

        <div class="team-selector-section">
            <h3>🔍 按球队筛选赛程</h3>
            <div class="selector-row">
                <select <select id="team-select" onchange="onTeamChange()">
                    <option value="all-teams">📋 全部 72 场比赛</option>
                    <option value="select-team" disabled>--- 选择球队 ---</option>
                    <option value="🇦🇷 阿根廷">🇦🇷 阿根廷</option>
                    <option value="🇩🇿 阿尔及利亚">🇩🇿 阿尔及利亚</option>
                    <option value="🇦🇺 澳大利亚">🇦🇺 澳大利亚</option>
                    <option value="🇦🇹 奥地利">🇦🇹 奥地利</option>
                    <option value="🇵🇦 巴拿马">🇵🇦 巴拿马</option>
                    <option value="🇧🇪 比利时">🇧🇪 比利时</option>
                    <option value="🇧🇦 波黑">🇧🇦 波黑</option>
                    <option value="🇧🇷 巴西">🇧🇷 巴西</option>
                    <option value="🇨🇦 加拿大">🇨🇦 加拿大</option>
                    <option value="🇨🇴 哥伦比亚">🇨🇴 哥伦比亚</option>
                    <option value="🇨🇮 科特迪瓦">🇨🇮 科特迪瓦</option>
                    <option value="🇭🇷 克罗地亚">🇭🇷 克罗地亚</option>
                    <option value="🇨🇼 库拉索">🇨🇼 库拉索</option>
                    <option value="🇨🇿 捷克">🇨🇿 捷克</option>
                    <option value="🇩🇰 丹麦">🇩🇰 丹麦</option>
                    <option value="🇪🇨 厄瓜多尔">🇪🇨 厄瓜多尔</option>
                    <option value="🇪🇬 埃及">🇪🇬 埃及</option>
                    <option value="🏴󠁧󠁢󠁥󠁮󠁧󠁿 英格兰">🏴󠁧󠁢󠁥󠁮󠁧󠁿 英格兰</option>
                    <option value="🇫🇷 法国">🇫🇷 法国</option>
                    <option value="🇨🇻 佛得角">🇨🇻 佛得角</option>
                    <option value="🇩🇪 德国">🇩🇪 德国</option>
                    <option value="🇬🇭 加纳">🇬🇭 加纳</option>
                    <option value="🇭🇹 海地">🇭🇹 海地</option>
                    <option value="🇭🇳 洪都拉斯">🇭🇳 洪都拉斯</option>
                    <option value="🇭🇺 匈牙利">🇭🇺 匈牙利</option>
                    <option value="🇮🇷 伊朗">🇮🇷 伊朗</option>
                    <option value="🇮🇶 伊拉克">🇮🇶 伊拉克</option>
                    <option value="🇯🇵 日本">🇯🇵 日本</option>
                    <option value="🇯🇴 约旦">🇯🇴 约旦</option>
                    <option value="🇰🇷 韩国">🇰🇷 韩国</option>
                    <option value="🇲🇽 墨西哥">🇲🇽 墨西哥</option>
                    <option value="🇲🇦 摩洛哥">🇲🇦 摩洛哥</option>
                    <option value="🇳🇱 荷兰">🇳🇱 荷兰</option>
                    <option value="🇳🇿 新西兰">🇳🇿 新西兰</option>
                    <option value="🇳🇴 挪威">🇳🇴 挪威</option>
                    <option value="🇵🇾 巴拉圭">🇵🇾 巴拉圭</option>
                    <option value="🇵🇹 葡萄牙">🇵🇹 葡萄牙</option>
                    <option value="🇶🇦 卡塔尔">🇶🇦 卡塔尔</option>
                    <option value="🇷🇴 罗马尼亚">🇷🇴 罗马尼亚</option>
                    <option value="🇸🇦 沙特阿拉伯">🇸🇦 沙特阿拉伯</option>
                    <option value="🏴󠁧󠁢󠁳󠁣󠁴󠁿 苏格兰">🏴󠁧󠁢󠁳󠁣󠁴󠁿 苏格兰</option>
                    <option value="🇸🇳 塞内加尔">🇸🇳 塞内加尔</option>
                    <option value="🇷🇸 塞尔维亚">🇷🇸 塞尔维亚</option>
                    <option value="🇪🇸 西班牙">🇪🇸 西班牙</option>
                    <option value="🇸🇪 瑞典">🇸🇪 瑞典</option>
                    <option value="🇨🇭 瑞士">🇨🇭 瑞士</option>
                    <option value="🇹🇳 突尼斯">🇹🇳 突尼斯</option>
                    <option value="🇹🇷 土耳其">🇹🇷 土耳其</option>
                    <option value="🇺🇾 乌拉圭">🇺🇾 乌拉圭</option>
                    <option value="🇺🇸 美国">🇺🇸 美国</option>
                    <option value="🇿🇦 南非">🇿🇦 南非</option>
                    <option value="🇺🇿 乌兹别克斯坦">🇺🇿 乌兹别克斯坦</option>
                    <option value="🇬🇷 希腊">🇬🇷 希腊</option>
                </select>
                <button class="btn btn-outline" onclick="copyTeamSubscribeLink()" style="padding: 10px 16px; font-size: 0.85rem; border-radius: 10px; white-space: nowrap;">📥 下载/复制 ICS</button>
            </div>
        </div>

        <div id="calendar-app"></div>

        <div class="footer">© 2026 WorldCup2026-Calendar · 数据来源: FIFA · Powered by Glenman</div>
    </div>
    
        <div class="team-selector-section">
            <h3>🎯 选择关注的球队</h3>
            <div id="selected-chips"></div>
            <div class="selector-actions">
                <button class="btn btn-outline" onclick="selectAll()">全选</button>
                <button class="btn btn-outline" onclick="deselectAll()">清空</button>
                <button class="btn btn-outline" onclick="selectAllHost()">只看东道主 🇨🇦🇺🇸🇲🇽</button>
                <button class="btn btn-outline" onclick="selectAllFavorites()">只看豪门 ⭐</button>
            </div>
        </div>

        <div class="group-selector">
            <div class="group-card">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-name">A组</span>
                    <span class="group-arrow">▼</span>
                </div>
                <div class="group-body">                    <div class="rank-row">
                        <span class="rank-label">种子队</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '')" data-team='⚽ '>
                                ⚽  👑
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第2档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '南非')" data-team='🇿🇦 南非'>
                                🇿🇦 南非 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第3档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '韩国')" data-team='🇰🇷 韩国'>
                                🇰🇷 韩国 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第4档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '捷克')" data-team='🇨🇿 捷克'>
                                🇨🇿 捷克 
                            </div>                        </div>
                    </div>                </div>
            </div>            <div class="group-card">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-name">B组</span>
                    <span class="group-arrow">▼</span>
                </div>
                <div class="group-body">                    <div class="rank-row">
                        <span class="rank-label">种子队</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '')" data-team='⚽ '>
                                ⚽  👑
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第2档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '波黑')" data-team='🇧🇦 波黑'>
