                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-name">I组</span>
                    <span class="group-arrow">▼</span>
                </div>
                <div class="group-body">                    <div class="rank-row">
                        <span class="rank-label">种子队</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '')" data-team='⚽ '>
                                ⚽  
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第2档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '塞内加尔')" data-team='🇸🇳 塞内加尔'>
                                🇸🇳 塞内加尔 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第3档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '伊拉克')" data-team='🇮🇶 伊拉克'>
                                🇮🇶 伊拉克 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第4档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '挪威')" data-team='🇳🇴 挪威'>
                                🇳🇴 挪威 
                            </div>                        </div>
                    </div>                </div>
            </div>            <div class="group-card">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-name">J组</span>
                    <span class="group-arrow">▼</span>
                </div>
                <div class="group-body">                    <div class="rank-row">
                        <span class="rank-label">种子队</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '')" data-team='⚽ '>
                                ⚽  👑
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第2档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '阿尔及利亚')" data-team='🇩🇿 阿尔及利亚'>
                                🇩🇿 阿尔及利亚 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第3档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '奥地利')" data-team='🇦🇹 奥地利'>
                                🇦🇹 奥地利 
                            </div>                        </div>
                    </div>                    <div class="rank-row">
                        <span class="rank-label">第4档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '约旦')" data-team='🇯🇴 约旦'>
                                🇯🇴 约旦 
