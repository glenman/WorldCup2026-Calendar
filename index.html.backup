                    </div>                    <div class="rank-row">
                        <span class="rank-label">第4档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '突尼斯')" data-team='🇹🇳 突尼斯'>
                                🇹🇳 突尼斯 
                            </div>                        </div>
