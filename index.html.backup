                        <span class="rank-label">第4档</span>
                        <div class="team-chips">                            <div class="team-chip" onclick="toggleTeam(this, '厄瓜多尔')" data-team='🇪🇨 厄瓜多尔'>
                                🇪🇨 厄瓜多尔 
                            </div>                        </div>
                    </div>                </div>
            </div>            <div class="group-card">
                <div class="group-header" onclick="toggleGroup(this)">
                    <span class="group-name">F组</span>
